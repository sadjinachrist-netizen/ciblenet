# Copier en .env puis lancer start.bat (ou coller ces lignes dans Streamlit Cloud > Settings > Secrets au format TOML)

# --- Génération des messages (Groq, gratuit) ---
GROQ_API_KEY=gsk_...
GROQ_API_KEY_2=gsk_...

# --- Canal Discord (webhook du salon) ---
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# --- Canal Gmail (SMTP + mot de passe d'application : myaccount.google.com > Sécurité > Validation en 2 étapes > Mots de passe des applications) ---
GMAIL_SENDER=toncompte@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
GMAIL_RECIPIENT=responsable.commercial@email.com

# --- Canal WhatsApp (Twilio Sandbox : twilio.com > Messaging > Try WhatsApp, rejoindre le sandbox depuis le téléphone destinataire) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=whatsapp:+228XXXXXXXX

# --- Canal SMS (optionnel : numéro Twilio + numéro destinataire vérifié dans le compte d'essai) ---
TWILIO_SMS_FROM=+1XXXXXXXXXX
TWILIO_SMS_TO=+228XXXXXXXX
